{
  "name": "zenyth-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zenyth 웹 이식 — 오목/렌주 분석반",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/gen-tokens.ts && vite",
    "studio": "tsx scripts/gen-tokens.ts && vite --open /joseki/studio",
    "curriculum:publish": "tsx scripts/curriculum-publish.ts",
    "build": "tsx scripts/gen-tokens.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsx scripts/gen-tokens.ts && tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tokens": "tsx scripts/gen-tokens.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check && vite build",
    "check:quick": "pnpm typecheck && pnpm lint && vitest run --changed && pnpm format:check",
    "engine:build": "bash tools/build_engine_wasm.sh",
    "serve": "node spike/serve.mjs",
    "w0:bench": "node spike/node-bench.mjs",
    "w0:node": "node spike/node-protocol.mjs",
    "w0:browser": "node spike/browser-test.mjs",
    "w0:summary": "node spike/summarize.mjs",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "tsc --noEmit && vite build --config showcase/vite.config.ts",
    "showcase:preview": "vite preview --config showcase/vite.config.ts"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dexie": "^4",
    "pretendard": "1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
