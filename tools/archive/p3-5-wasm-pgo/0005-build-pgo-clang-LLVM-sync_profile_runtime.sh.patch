Subject: [PATCH 05/10] =?UTF-8?q?build(pgo):=20=ED=94=84=EB=A1=9C=ED=8C=8C?=
 =?UTF-8?q?=EC=9D=BC=20=EB=9F=B0=ED=83=80=EC=9E=84=EC=9D=84=20clang=20?=
 =?UTF-8?q?=EC=9D=98=20LLVM=20=EC=BB=A4=EB=B0=8B=EC=9C=BC=EB=A1=9C=20?=
 =?UTF-8?q?=EB=A7=9E=EC=B6=98=EB=8B=A4(sync=5Fprofile=5Fruntime.sh)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3차 진단의 원인: Emscripten 6.0.11 이 싣는 compiler-rt 프로파일 런타임은 raw 형식 10, 그 clang(LLVM
24.0.0git)은 11 — IR 계측은 기록을 거부하고, 프런트엔드 계측은 데이터 배치를 잘못 읽어 종료 때
initializeValueProfRuntimeRecord 에서 OOB. clang --version 의 커밋에서 compiler-rt/{lib,include}/profile 를
받아 Emscripten 의 같은 경로를 바꾸고 캐시 라이브러리를 지워 다시 짓게 한다(멱등 · 원본 .orig 보존).
엔진 코드는 그대로. 진단 F(프런트엔드 · 값 프로파일 켬) · G(IR).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/pgo.yml         |  9 +++--
 tools/build_engine_wasm_pgo.sh    | 10 +++++-
 tools/pgo/sync_profile_runtime.sh | 60 +++++++++++++++++++++++++++++++
 3 files changed, 75 insertions(+), 4 deletions(-)
 create mode 100755 tools/pgo/sync_profile_runtime.sh

diff --git a/.github/workflows/pgo.yml b/.github/workflows/pgo.yml
index 156757c..80116f1 100644
--- a/.github/workflows/pgo.yml
+++ b/.github/workflows/pgo.yml
@@ -65,9 +65,12 @@ jobs:
           # 2차(37171485247): 링크에도 -disable-vp 를 줬지만 모듈 ID 가 A · B 와 같았다 — 그 옵션은 IR 계측용이고 프런트엔드
           # 계측의 값 프로파일은 -enable-value-profiling 이 정한다(D). E 는 IR 계측(-fprofile-generate) + -disable-vp.
           # 모듈이 실제로 바뀌었는지 sha256 으로 확인한다.
-          for v in D E; do
-            if [ $v = D ]; then kind=fe; gen="-mllvm -enable-value-profiling=false"; genld="--profiling-funcs -Wl,-mllvm,-enable-value-profiling=false"
-            else kind=ir; gen="-mllvm -disable-vp=true"; genld="--profiling-funcs -Wl,-mllvm,-disable-vp=true"; fi
+          # 3차(37171907436): IR 계측은 죽지 않았지만 "Runtime and instrumentation version mismatch : expected 10, but get 11"
+          # — Emscripten 의 프로파일 런타임이 clang 보다 오래됐다. build_engine_wasm_pgo.sh 가 이제 런타임을 clang 의 LLVM
+          # 커밋으로 맞춘다(sync_profile_runtime.sh). F = 프런트엔드 계측 그대로(값 프로파일 켬), G = IR 계측.
+          for v in F G; do
+            if [ $v = F ]; then kind=fe; else kind=ir; fi
+            gen=""; genld="--profiling-funcs"
             echo "================ 진단 $v — PGO_KIND=$kind PGO_GEN_CFLAGS='$gen' PGO_GEN_LDFLAGS='$genld'"
             PGO_KIND=$kind PGO_GEN_CFLAGS="$gen" PGO_GEN_LDFLAGS="$genld" PGO_TRAIN_LIMIT=3 PGO_TRAIN_NODES=20000 \
               PGO_STOP_AFTER_TRAIN=1 bash tools/build_engine_wasm_pgo.sh > diag-$v.log 2>&1 && echo "진단 $v: 성공" || echo "진단 $v: 실패"
diff --git a/tools/build_engine_wasm_pgo.sh b/tools/build_engine_wasm_pgo.sh
index c54f397..a4a817d 100755
--- a/tools/build_engine_wasm_pgo.sh
+++ b/tools/build_engine_wasm_pgo.sh
@@ -20,7 +20,15 @@ rm -rf "$PGO_DIR"
 mkdir -p "$PGO_DIR/inst"
 
 echo "=========================================================="
-echo " PGO 1/4 — 계측 빌드(single-simd128, -fprofile-instr-generate)"
+echo " PGO 0/4 — 프로파일 런타임을 clang 과 같은 LLVM 으로(tools/pgo/sync_profile_runtime.sh)"
+echo "=========================================================="
+# emsdk 6.0.11 의 런타임은 raw 형식 10, 그 clang 은 11 — 맞추지 않으면 계측 WASM 이 종료 때 죽거나 기록을 거부한다
+if [ "${PGO_SYNC_RUNTIME:-1}" = "1" ]; then
+  WORK="$WORK" bash "$ROOT/tools/pgo/sync_profile_runtime.sh"
+fi
+
+echo "=========================================================="
+echo " PGO 1/4 — 계측 빌드(single-simd128, PGO_KIND=${PGO_KIND:-fe})"
 echo "=========================================================="
 PGO_GENERATE=1 PGO_PROFILE="" BASE_VARIANTS=single-simd128 EXTRA_VARIANTS="" WASM_OPT_POST="" \
   EXTRA_LDFLAGS="${PGO_GEN_LDFLAGS:-}" bash "$ROOT/tools/build_engine_wasm.sh"
diff --git a/tools/pgo/sync_profile_runtime.sh b/tools/pgo/sync_profile_runtime.sh
new file mode 100755
index 0000000..c013e84
--- /dev/null
+++ b/tools/pgo/sync_profile_runtime.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+#
+# Emscripten 의 LLVM 프로파일 런타임을 그 clang 과 같은 LLVM 커밋으로 맞춘다 — PGO 계측 빌드 전에(P3-5).
+#
+# 왜: emsdk 6.0.11 의 clang 은 LLVM 24.0.0git(raw 프로파일 형식 11)인데, Emscripten 이 함께 싣는 compiler-rt
+# 프로파일 런타임(system/lib/compiler-rt/lib/profile)은 그보다 오래돼 형식 10 이다. 그 결과
+#   IR 계측(-fprofile-generate):        "LLVM Profile Error: Runtime and instrumentation version mismatch : expected 10, but get 11"
+#   프런트엔드 계측(-fprofile-instr-generate): 종료 때 initializeValueProfRuntimeRecord 에서 memory access out of bounds
+# (pgo.yml 진단 37171091827 · 37171907436). 엔진 코드가 아니라 툴체인 문제다.
+#
+# 어떻게: clang --version 이 찍는 LLVM 커밋에서 compiler-rt/{lib,include}/profile 만 받아(얕은 sparse 클론)
+# Emscripten 의 같은 경로를 바꾸고, 캐시의 프로파일 라이브러리를 지워 emcc 가 다음 링크 때 새로 짓게 한다.
+# 이미 맞으면 아무것도 하지 않는다(멱등). 원본은 .orig 로 남긴다.
+set -eu
+
+EMSDK_DIR="${EMSDK_DIR:-${WORK:-$HOME/rapfi-wasm-work}/emsdk}"
+EM="$EMSDK_DIR/upstream/emscripten"
+CLANG="$EMSDK_DIR/upstream/bin/clang"
+RT="$EM/system/lib/compiler-rt"
+[ -x "$CLANG" ] && [ -d "$RT/lib/profile" ] || { echo "  X emsdk 를 찾지 못했습니다: $EMSDK_DIR"; exit 1; }
+
+ver_of () { grep -m1 -E "^#define INSTR_PROF_RAW_VERSION " "$1/include/profile/InstrProfData.inc" | awk '{print $3}'; }
+commit="$("$CLANG" --version | sed -n 's/.*llvm-project \([0-9a-f]\{40\}\).*/\1/p' | head -1)"
+[ -n "$commit" ] || { echo "  X clang --version 에서 LLVM 커밋을 못 읽었습니다: $("$CLANG" --version | head -1)"; exit 1; }
+echo "  . clang LLVM 커밋 $commit"
+echo "  . Emscripten 런타임 raw 형식 $(ver_of "$RT")"
+echo "  . Emscripten 의 프로파일 라이브러리 정의:"
+grep -n -A12 -i "class libprofile\|clang_rt.profile\|'profile'" "$EM/tools/system_libs.py" | head -24 | sed "s/^/    | /" || true
+
+STAMP="$RT/.synced-llvm-commit"
+if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$commit" ]; then
+  echo "  . 이미 $commit 에 맞춰져 있음 — 건너뜀"
+  exit 0
+fi
+
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+git -C "$tmp" init -q
+git -C "$tmp" remote add origin https://github.com/llvm/llvm-project.git
+git -C "$tmp" config core.sparseCheckout true
+printf '%s\n' compiler-rt/lib/profile compiler-rt/include/profile > "$tmp/.git/info/sparse-checkout"
+git -C "$tmp" fetch -q --depth 1 --filter=blob:none origin "$commit"
+git -C "$tmp" checkout -q FETCH_HEAD
+up="$tmp/compiler-rt"
+echo "  . LLVM $commit 의 런타임 raw 형식 $(ver_of "$up")"
+
+# 바꾸기 — Emscripten 이 목록으로 고르는 파일만 쓰더라도 새 파일이 생겼을 수 있으니 디렉터리째
+for d in lib/profile include/profile; do
+  [ -d "$RT/$d.orig" ] || cp -r "$RT/$d" "$RT/$d.orig"
+  rm -rf "${RT:?}/$d"
+  cp -r "$up/$d" "$RT/$d"
+done
+echo "$commit" > "$STAMP"
+echo "  . 바꿈 — Emscripten 런타임 raw 형식 이제 $(ver_of "$RT")"
+
+# 캐시의 프로파일 라이브러리를 지운다(다음 링크에서 emcc 가 새 소스로 짓는다)
+n=0
+while IFS= read -r f; do rm -f "$f"; n=$((n + 1)); echo "    - $f"; done \
+  < <(find "$EM/cache" -iname "*profile*" -name "*.a" 2> /dev/null)
+echo "  . 캐시에서 지운 프로파일 라이브러리 $n 개"
-- 
