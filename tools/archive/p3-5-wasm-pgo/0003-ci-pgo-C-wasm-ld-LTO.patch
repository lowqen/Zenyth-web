 =?UTF-8?q?=E2=80=94=20=EA=B0=92=20=ED=94=84=EB=A1=9C=ED=8C=8C=EC=9D=BC=20?=
 =?UTF-8?q?=EB=81=84=EA=B8=B0=EB=A5=BC=20=EB=A7=81=ED=81=AC(wasm-ld=20LTO)?=
