Content-Transfer-Encoding: 8bit

1차 진단: 종료 때 initializeValueProfRuntimeRecord 에서 OOB. 컴파일에만 -disable-vp 를 준 빌드는
모듈 ID 가 같았다 — LTO 라 계측 낮춤이 링크 때 돈다.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/pgo.yml | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/pgo.yml b/.github/workflows/pgo.yml
index d6f645b..b229a52 100644
--- a/.github/workflows/pgo.yml
+++ b/.github/workflows/pgo.yml
@@ -59,12 +59,15 @@ jobs:
       - name: 진단 — 프로파일 꺼내기(A 이름만 · B 이름 + 값 프로파일 끔), 각각 3국면 훈련
         if: inputs.mode == 'diag'
         run: |
-          for v in A B; do
-            if [ $v = A ]; then gen=""; else gen="-mllvm -disable-vp=true"; fi
-            echo "================ 진단 $v — PGO_GEN_CFLAGS='$gen'"
-            PGO_GEN_CFLAGS="$gen" PGO_GEN_LDFLAGS="--profiling-funcs" PGO_TRAIN_LIMIT=3 PGO_TRAIN_NODES=20000 \
+          # 1차 진단(37171091827): 종료 때 값 프로파일 런타임(initializeValueProfRuntimeRecord)에서 OOB. 컴파일에만
+          # -mllvm -disable-vp=true 를 준 빌드는 모듈 ID 까지 같았다 — LTO 라 계측 낮춤이 링크(wasm-ld) 때 돈다.
+          # 그래서 링크에도 -Wl,-mllvm,-disable-vp=true 를 준다(C).
+          for v in C; do
+            gen="-mllvm -disable-vp=true"; genld="--profiling-funcs -Wl,-mllvm,-disable-vp=true"
+            echo "================ 진단 $v — PGO_GEN_CFLAGS='$gen' PGO_GEN_LDFLAGS='$genld'"
+            PGO_GEN_CFLAGS="$gen" PGO_GEN_LDFLAGS="$genld" PGO_TRAIN_LIMIT=3 PGO_TRAIN_NODES=20000 \
               PGO_STOP_AFTER_TRAIN=1 bash tools/build_engine_wasm_pgo.sh > diag-$v.log 2>&1 && echo "진단 $v: 성공" || echo "진단 $v: 실패"
-            grep -E "훈련 국면|\[pgo\]|RuntimeError|at .*wasm-function|at [_A-Za-z].*\(wasm|profraw|Total functions|Maximum function count|X " diag-$v.log | head -40
+            grep -E "훈련 국면|\[pgo\]|RuntimeError|wasm-function|profraw|Total functions|Maximum function count|  X |PGO_STOP" diag-$v.log | head -40
           done
 
       - name: 기준 빌드 — 배포 구성(P2-2 + -O4 --converge), PGO 없음
