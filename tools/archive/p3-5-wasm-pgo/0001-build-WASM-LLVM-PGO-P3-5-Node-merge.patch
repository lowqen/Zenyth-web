+// END → emscripten_force_exit → atexit(프로파일 기록) → onExit(profdump.js 가 디스크로) → process.exit
+try {
+  send("END");
+} catch (e) {
+  if (!(e && (e.name === "ExitStatus" || typeof e.status === "number"))) throw e;
+}
