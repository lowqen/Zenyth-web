From aaebf30c5eea0a278ef50f43a3c95fcde0f51a83 Mon Sep 17 00:00:00 2001
From: lowqen <lowqen@gmail.com>
Date: Sun, 4 Oct 2026 11:42:55 +0900
Subject: [PATCH 04/10] =?UTF-8?q?build(pgo):=20PGO=5FKIND(fe=20|=20ir)=20?=
 =?UTF-8?q?=C2=B7=20profdump=20=EB=8A=94=20=EB=A3=A8=ED=8A=B8=EC=9D=98=20.?=
 =?UTF-8?q?profraw=20=EB=A5=BC=20=EC=B0=BE=EC=9D=8C=20=C2=B7=20=EC=A7=84?=
 =?UTF-8?q?=EB=8B=A8=20D/E?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

2차 진단: 링크에도 -disable-vp 를 줬지만 계측 wasm 이 A · B 와 같았다(모듈 ID 0084271a) —
-disable-vp 는 IR 계측 옵션이고 프런트엔드 계측의 값 프로파일은 -enable-value-profiling 이 정한다.
D = fe + enable-value-profiling=false, E = ir(-fprofile-generate) + disable-vp. 모듈 sha256 확인.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/pgo.yml  | 13 +++++++++----
 tools/build_engine_wasm.sh | 19 +++++++++++++------
 tools/pgo/profdump.js      | 11 ++++++++---
 3 files changed, 30 insertions(+), 13 deletions(-)

diff --git a/.github/workflows/pgo.yml b/.github/workflows/pgo.yml
index b229a52..156757c 100644
--- a/.github/workflows/pgo.yml
+++ b/.github/workflows/pgo.yml
@@ -62,11 +62,16 @@ jobs:
           # 1차 진단(37171091827): 종료 때 값 프로파일 런타임(initializeValueProfRuntimeRecord)에서 OOB. 컴파일에만
           # -mllvm -disable-vp=true 를 준 빌드는 모듈 ID 까지 같았다 — LTO 라 계측 낮춤이 링크(wasm-ld) 때 돈다.
           # 그래서 링크에도 -Wl,-mllvm,-disable-vp=true 를 준다(C).
-          for v in C; do
-            gen="-mllvm -disable-vp=true"; genld="--profiling-funcs -Wl,-mllvm,-disable-vp=true"
-            echo "================ 진단 $v — PGO_GEN_CFLAGS='$gen' PGO_GEN_LDFLAGS='$genld'"
-            PGO_GEN_CFLAGS="$gen" PGO_GEN_LDFLAGS="$genld" PGO_TRAIN_LIMIT=3 PGO_TRAIN_NODES=20000 \
+          # 2차(37171485247): 링크에도 -disable-vp 를 줬지만 모듈 ID 가 A · B 와 같았다 — 그 옵션은 IR 계측용이고 프런트엔드
+          # 계측의 값 프로파일은 -enable-value-profiling 이 정한다(D). E 는 IR 계측(-fprofile-generate) + -disable-vp.
+          # 모듈이 실제로 바뀌었는지 sha256 으로 확인한다.
+          for v in D E; do
+            if [ $v = D ]; then kind=fe; gen="-mllvm -enable-value-profiling=false"; genld="--profiling-funcs -Wl,-mllvm,-enable-value-profiling=false"
+            else kind=ir; gen="-mllvm -disable-vp=true"; genld="--profiling-funcs -Wl,-mllvm,-disable-vp=true"; fi
+            echo "================ 진단 $v — PGO_KIND=$kind PGO_GEN_CFLAGS='$gen' PGO_GEN_LDFLAGS='$genld'"
+            PGO_KIND=$kind PGO_GEN_CFLAGS="$gen" PGO_GEN_LDFLAGS="$genld" PGO_TRAIN_LIMIT=3 PGO_TRAIN_NODES=20000 \
               PGO_STOP_AFTER_TRAIN=1 bash tools/build_engine_wasm_pgo.sh > diag-$v.log 2>&1 && echo "진단 $v: 성공" || echo "진단 $v: 실패"
+            sha256sum "$WORK/pgo/inst/rapfi-single-simd128.wasm" | cut -c1-16 | sed 's/^/  계측 wasm sha256 /'
             grep -E "훈련 국면|\[pgo\]|RuntimeError|wasm-function|profraw|Total functions|Maximum function count|  X |PGO_STOP" diag-$v.log | head -40
           done
 
diff --git a/tools/build_engine_wasm.sh b/tools/build_engine_wasm.sh
index 2543145..ba5d141 100755
--- a/tools/build_engine_wasm.sh
+++ b/tools/build_engine_wasm.sh
@@ -71,6 +71,13 @@ PGO_GENERATE="${PGO_GENERATE:-}"
 PGO_PROFILE="${PGO_PROFILE:-}"
 # 기본 변형(공백 구분). 계측 빌드는 훈련에 쓰는 단일 스레드만 만들면 된다(BASE_VARIANTS=single-simd128).
 BASE_VARIANTS="${BASE_VARIANTS:-single-simd128 multi-simd128}"
+# PGO 종류: fe = 프런트엔드 계측(-fprofile-instr-generate / -fprofile-instr-use, 기본) · ir = IR 계측(-fprofile-generate / -fprofile-use)
+PGO_KIND="${PGO_KIND:-fe}"
+case "$PGO_KIND" in
+  fe) PGO_GEN_FLAG="-fprofile-instr-generate"; PGO_USE_FLAG="-fprofile-instr-use" ;;
+  ir) PGO_GEN_FLAG="-fprofile-generate";       PGO_USE_FLAG="-fprofile-use" ;;
+  *) echo "  X PGO_KIND 는 fe 또는 ir: $PGO_KIND"; exit 1 ;;
+esac
 if [ -n "$PGO_GENERATE" ] && [ -n "$PGO_PROFILE" ]; then
   echo "  X PGO_GENERATE 와 PGO_PROFILE 은 함께 쓸 수 없다"
   exit 1
@@ -257,11 +264,11 @@ build_variant () {
   local cflags="" ldflags="$EXTRA_LDFLAGS"
   if [ -n "$PGO_GENERATE" ]; then
     # PGO_GEN_CFLAGS: 계측 빌드에만 더할 컴파일 플래그(예: -mllvm -disable-vp=true — 값 프로파일 끄기)
-    cflags="-fprofile-instr-generate ${PGO_GEN_CFLAGS:-}"
-    ldflags="$ldflags -fprofile-instr-generate --pre-js $ROOT/tools/pgo/profdump.js"
+    cflags="$PGO_GEN_FLAG ${PGO_GEN_CFLAGS:-}"
+    ldflags="$ldflags $PGO_GEN_FLAG --pre-js $ROOT/tools/pgo/profdump.js"
   elif [ -n "$PGO_PROFILE" ]; then
     # 프로파일에 없는 함수(다른 변형 · 훈련이 안 닿은 경로)는 경고만 — PGO 없이 컴파일된다
-    cflags="-fprofile-instr-use=$PGO_PROFILE -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date -Wno-backend-plugin"
+    cflags="$PGO_USE_FLAG=$PGO_PROFILE -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date -Wno-backend-plugin"
   fi
 
   echo "--- build: $name (threads=$threads relaxed=$relaxed${cflags:+ · $cflags}) ---"
@@ -464,12 +471,12 @@ verify () {
     fail=1
   fi
   if [ -n "$PGO_GENERATE" ]; then
-    grep -q -- "-fprofile-instr-generate" "$nj" || { echo "  X PGO_GENERATE 인데 -fprofile-instr-generate 가 없다"; fail=1; }
+    grep -q -- "$PGO_GEN_FLAG" "$nj" || { echo "  X PGO_GENERATE 인데 $PGO_GEN_FLAG 가 없다"; fail=1; }
     grep -q -- "profdump.js" "$nj" || { echo "  X PGO_GENERATE 인데 profdump.js(프로파일 꺼내기)가 없다"; fail=1; }
   elif [ -n "$PGO_PROFILE" ]; then
-    grep -q -- "-fprofile-instr-use=" "$nj" || { echo "  X PGO_PROFILE 인데 -fprofile-instr-use 가 없다"; fail=1; }
+    grep -q -- "$PGO_USE_FLAG=" "$nj" || { echo "  X PGO_PROFILE 인데 $PGO_USE_FLAG 가 없다"; fail=1; }
   else
-    grep -q -- "-fprofile-instr" "$nj" && { echo "  X PGO 를 켜지 않았는데 -fprofile-instr 플래그가 있다(이전 빌드 캐시?)"; fail=1; }
+    grep -q -E -- "-fprofile-(instr-)?(generate|use)" "$nj" && { echo "  X PGO 를 켜지 않았는데 -fprofile-… 플래그가 있다(이전 빌드 캐시?)"; fail=1; }
   fi
   if ! grep -q -- "preamble.js" "$nj"; then
     echo "  X --pre-js preamble.js 가 없다 — sendCommand 펌프 없이 나온 빌드다"
diff --git a/tools/pgo/profdump.js b/tools/pgo/profdump.js
index 5baa9a6..81d1d3e 100644
--- a/tools/pgo/profdump.js
+++ b/tools/pgo/profdump.js
@@ -14,11 +14,16 @@
     if (typeof process !== "undefined" && process.versions && process.versions.node) {
       var out = (process.env && process.env.RAPFI_PROFRAW) || "rapfi.profraw";
       try {
-        var data = FS.readFile("/default.profraw");
+        // 프런트엔드 계측은 default.profraw, IR 계측(-fprofile-generate)은 default_<id>.profraw — 루트의 .profraw 를 모두
+        var names = FS.readdir("/").filter(function (n) {
+          return /\.profraw$/.test(n);
+        });
+        if (names.length !== 1) throw new Error("루트의 .profraw 가 " + names.length + "개: " + names.join(","));
+        var data = FS.readFile("/" + names[0]);
         require("fs").writeFileSync(out, data);
-        process.stderr.write("[pgo] profraw " + data.length + " bytes -> " + out + "\n");
+        process.stderr.write("[pgo] /" + names[0] + " " + data.length + " bytes -> " + out + "\n");
       } catch (e) {
-        process.stderr.write("[pgo] /default.profraw 를 꺼내지 못함: " + e + "\n");
+        process.stderr.write("[pgo] 프로파일을 꺼내지 못함: " + e + "\n");
       }
     }
     if (prev) prev(code);
-- 
2.56.0.windows.4

